# Copy this file to .env and fill in real values. Every variable below is
# actually read somewhere in python/ — this file is the source of truth for
# a fresh deploy, not the README's quick-glance summary.

# --- Shared with server/.env (must match exactly) ---
JWT_SECRET=
INTERNAL_SECRET=

NODE_INTERNAL_URL=http://localhost:3000
# Extra CORS origins beyond the built-in localhost:5173 defaults, comma-separated.
CORS_ALLOW_ORIGINS=

# --- LLM backend selection ---
# false = use the cloud provider order below; true = use Ollama (local).
USE_LOCAL_LLM=false
CLOUD_LLM_ORDER=groq,gemini

# Groq — GROQ_API_KEY_2/_3 are optional extra keys for dual/triple-key
# failover when the primary key hits a rate limit.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (only used when USE_LOCAL_LLM=true) ---
# Start the tray app or `ollama serve` first.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MODEL_SIZE=3b
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=5m

# --- Whisper (local speech-to-text, faster-whisper) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Deployment (Cloudflare — set by cloudflare/src/index.js, not needed locally) ---
# true = don't start the 30-minute recurring-source poll loop; Node's
# scheduled jobs call POST /internal/poll-sources when a source is due.
DISABLE_SCHEDULERS=
# Cloudflare R2 (S3 API): chroma_db/ is restored from / saved to this bucket
# (kb/chroma_db.tar.gz) and daily backups go to kb/backups/, because a
# container's disk is wiped on sleep/redeploy (kb_snapshot.py). Leave empty
# to keep the knowledge base on local disk only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
