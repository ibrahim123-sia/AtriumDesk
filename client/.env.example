# Copy this file to .env and fill in real values.

# Local development
VITE_SERVER_URL=http://localhost:3000
VITE_PYTHON_URL=http://localhost:8000

# Cloudflare: both point at the backend Worker (the AI service is under /ai)
# VITE_SERVER_URL=https://atriumdesk-api.<your-subdomain>.workers.dev
# VITE_PYTHON_URL=https://atriumdesk-api.<your-subdomain>.workers.dev/ai

# The web client's own public address (no trailing slash). Optional: the build
# then adds canonical links, absolute link-preview URLs and sitemap.xml.
# VITE_SITE_URL=https://atriumdesk-web.<your-subdomain>.workers.dev
