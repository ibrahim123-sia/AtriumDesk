# Cloudflare static assets: Vite's hashed bundles never change, cache them
# for a year; everything else (index.html) is revalidated on each visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The PWA service worker must be re-checked on every visit, or a new deploy
# keeps serving the old app shell.
/sw.js
  Cache-Control: no-cache

# No other site may frame the app (clickjacking on the signed-in pages)...
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# ...except the guest chat the website widget shows inside universities' sites.
/embed
  ! Content-Security-Policy
  ! X-Frame-Options
  X-Robots-Tag: noindex

# A personal link from an email; never in search results.
/unsubscribe
  X-Robots-Tag: noindex

# The widget script is loaded by universities' websites.
/widget.js
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
