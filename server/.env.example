# Copy this file to .env and fill in real values. Every variable below is
# actually read somewhere in server/ — this file is the source of truth for
# a fresh deploy, not the README's quick-glance summary.

# --- Core ---
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
PYTHON_BACKEND_URL=http://localhost:8000

# --- Database ---
# One shared MongoDB cluster — each tenant gets its own database on it
# (server/config/tenantDb.js), plus one PlatformDB for the tenant registry
# and Super Admin users.
MONGODB_URI=mongodb://localhost:27017/AtriumDesk
PLATFORM_DB_NAME=AtriumDeskPlatform

# --- Secrets (generate strong random values, e.g. `openssl rand -hex 48`) ---
JWT_SECRET=
# Deliberately separate from JWT_SECRET — keeps Super Admin sessions
# unforgeable even if a tenant secret ever leaks.
PLATFORM_JWT_SECRET=
# Shared secret for Python<->Node internal/webhook calls (x-internal-secret header).
INTERNAL_SECRET=
# 32-byte hex key used to encrypt a tenant's own SMTP app password at rest.
FIELD_ENCRYPTION_KEY=

# --- Seeding (server/scripts/seedTenant.js) ---
# Super Admin user, created/updated on first run.
SUPERADMIN_EMAIL=superadmin@platform.test
SUPERADMIN_NAME=Platform Super Admin
SUPERADMIN_PASSWORD=
# First tenant + its Administrator, created/updated on first run.
TENANT_SLUG=maju
TENANT_NAME=Muhammad Ali Jinnah University
TENANT_CHROMA_COLLECTION=university_chunks
TENANT_DB_NAME=
TENANT_EMAIL_DOMAINS=maju.edu.pk
TENANT_STAFF_EMAIL_PATTERN=maju.{dept}.edu
ADMIN_EMAIL=administrator@atriumdesk.edu
ADMIN_NAME=AtriumDesk Administrator
ADMIN_PASSWORD=

# --- Platform-default email sending ---
# Used whenever a tenant hasn't configured its own SMTP account in Settings.
EMAIL_USER=
EMAIL_PASS=

# --- Uploads ---
# Optional override for where issue attachments are stored on disk.
UPLOAD_DIR=uploads/issues

# --- Which tenant guest/legacy traffic resolves to ---
DEFAULT_TENANT_SLUG=maju
